<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>CodeMap.Cli</RootNamespace>
    <AssemblyName>codemap</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codemap</ToolCommandName>
    <ApplicationIcon>Assets\codemap.ico</ApplicationIcon>
    <Product>CodeMap</Product>
    <PackageId>CodeMap.Tool</PackageId>
    <Description>Maps C# solutions (and TypeScript / JavaScript and C / C++ with Node.js, Python with Python 3.9+) into a relationship graph (JSON, DGML, GraphML, Cypher) and an interactive 3D map.</Description>
    <PackageTags>code-map;architecture;dependency-graph;visualization;csharp;roslyn;typescript;javascript;python;cpp;c;cmake;qt;unreal;swift;swiftui;xcode;nestjs;angular;dependency-injection;3d</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- What nuget.org shows: the readme, the icon (the extension's) and the license text. -->
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\vscode\media\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- `dotnet publish -r <rid>` (win-x64, linux-x64, osx-arm64...) produces one executable that runs without .NET installed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMap.Core\CodeMap.Core.csproj" />
    <ProjectReference Include="..\CodeMap.Server\CodeMap.Server.csproj" />
    <ProjectReference Include="..\CodeMap.Mcp\CodeMap.Mcp.csproj" />
  </ItemGroup>

  <!--
    The TypeScript / JavaScript language plugin (analyzers/typescript) goes next to the program, in plugins/typescript,
    with the TypeScript compiler it runs on (vendor/typescript); never inside a single-file executable, Node.js runs it.
    Needs `npm ci` in analyzers/typescript first; without it CodeMap is built for C# alone.
  -->
  <PropertyGroup>
    <TypeScriptPlugin>$(MSBuildThisFileDirectory)..\..\analyzers\typescript\</TypeScriptPlugin>
    <TypeScriptCompiler>$(TypeScriptPlugin)node_modules\typescript\</TypeScriptCompiler>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TypeScriptCompiler)lib\typescript.js')">
    <Content Include="$(TypeScriptPlugin)codemap-plugin.json;$(TypeScriptPlugin)package.json" Link="plugins\typescript\%(Filename)%(Extension)" />
    <Content Include="$(TypeScriptPlugin)src\**\*.mjs" Link="plugins\typescript\src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(TypeScriptCompiler)lib\typescript.js;$(TypeScriptCompiler)lib\lib*.d.ts" Link="plugins\typescript\vendor\typescript\lib\%(Filename)%(Extension)" />
    <!-- Its own package.json tells Node that typescript.js is CommonJS (the plugin's says ES modules). -->
    <Content Include="$(TypeScriptCompiler)package.json;$(TypeScriptCompiler)LICENSE.txt;$(TypeScriptCompiler)ThirdPartyNoticeText.txt" Link="plugins\typescript\vendor\typescript\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pack="false": the dotnet tool gets the plugin with the published program (tools/…/plugins), not as package content. -->
    <Content Update="$(TypeScriptPlugin)**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>
  <Target Name="TypeScriptPluginMissing" BeforeTargets="Build" Condition="!Exists('$(TypeScriptCompiler)lib\typescript.js')">
    <Warning Text="The TypeScript plugin is not included: run npm ci in analyzers/typescript to map TypeScript and JavaScript too." />
  </Target>

  <!--
    The Python language plugin (analyzers/python) goes next to the program too, in plugins/python. Python runs it from
    its source files with the standard library alone, so there is nothing to build or install first.
  -->
  <PropertyGroup>
    <PythonPlugin>$(MSBuildThisFileDirectory)..\..\analyzers\python\</PythonPlugin>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(PythonPlugin)codemap-plugin.json" Link="plugins\python\%(Filename)%(Extension)" />
    <Content Include="$(PythonPlugin)src\**\*.py" Exclude="$(PythonPlugin)src\**\__pycache__\**" Link="plugins\python\src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Update="$(PythonPlugin)**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>

  <!--
    The C / C++ language plugin (analyzers/cpp) goes next to the program, in plugins/cpp, with tree-sitter and the C and
    C++ grammars it parses with (vendor/): WebAssembly, so one build serves every platform; Node.js runs it.
    Needs `npm ci` in analyzers/cpp first; without it CodeMap is built without C and C++.
  -->
  <PropertyGroup>
    <CppPlugin>$(MSBuildThisFileDirectory)..\..\analyzers\cpp\</CppPlugin>
    <CppParser>$(CppPlugin)node_modules\web-tree-sitter\</CppParser>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CppParser)tree-sitter.js')">
    <Content Include="$(CppPlugin)codemap-plugin.json;$(CppPlugin)package.json" Link="plugins\cpp\%(Filename)%(Extension)" />
    <Content Include="$(CppPlugin)src\**\*.mjs" Link="plugins\cpp\src\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Its own package.json tells Node that tree-sitter.js is an ES module; tree-sitter.wasm is looked up next to it. -->
    <Content Include="$(CppParser)tree-sitter.js;$(CppParser)tree-sitter.wasm;$(CppParser)package.json;$(CppParser)LICENSE" Link="plugins\cpp\vendor\web-tree-sitter\%(Filename)%(Extension)" />
    <Content Include="$(CppPlugin)node_modules\tree-sitter-cpp\tree-sitter-cpp.wasm;$(CppPlugin)node_modules\tree-sitter-c\tree-sitter-c.wasm" Link="plugins\cpp\vendor\grammars\%(Filename)%(Extension)" />
    <Content Include="$(CppPlugin)node_modules\tree-sitter-cpp\LICENSE" Link="plugins\cpp\vendor\grammars\LICENSE-tree-sitter-cpp" />
    <Content Include="$(CppPlugin)node_modules\tree-sitter-c\LICENSE" Link="plugins\cpp\vendor\grammars\LICENSE-tree-sitter-c" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="$(CppPlugin)**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>
  <Target Name="CppPluginMissing" BeforeTargets="Build" Condition="!Exists('$(CppParser)tree-sitter.js')">
    <Warning Text="The C / C++ plugin is not included: run npm ci in analyzers/cpp to map C and C++ too." />
  </Target>

  <!--
    The Swift language plugin (analyzers/swift) goes next to the program, in plugins/swift, with tree-sitter (vendor/)
    and its Swift grammar (grammar/, built from source and kept in the repository; see its README). Node.js runs it.
    Needs `npm ci` in analyzers/swift first; without it CodeMap is built without Swift.
  -->
  <PropertyGroup>
    <SwiftPlugin>$(MSBuildThisFileDirectory)..\..\analyzers\swift\</SwiftPlugin>
    <SwiftParser>$(SwiftPlugin)node_modules\web-tree-sitter\</SwiftParser>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SwiftParser)tree-sitter.js')">
    <Content Include="$(SwiftPlugin)codemap-plugin.json;$(SwiftPlugin)package.json" Link="plugins\swift\%(Filename)%(Extension)" />
    <Content Include="$(SwiftPlugin)src\**\*.mjs" Link="plugins\swift\src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(SwiftPlugin)grammar\tree-sitter-swift.wasm;$(SwiftPlugin)grammar\LICENSE;$(SwiftPlugin)grammar\README.md" Link="plugins\swift\grammar\%(Filename)%(Extension)" />
    <Content Include="$(SwiftParser)tree-sitter.js;$(SwiftParser)tree-sitter.wasm;$(SwiftParser)package.json;$(SwiftParser)LICENSE" Link="plugins\swift\vendor\web-tree-sitter\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="$(SwiftPlugin)**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
  </ItemGroup>
  <Target Name="SwiftPluginMissing" BeforeTargets="Build" Condition="!Exists('$(SwiftParser)tree-sitter.js')">
    <Warning Text="The Swift plugin is not included: run npm ci in analyzers/swift to map Swift too." />
  </Target>

  <!-- Single-file 3D viewer, produced by `npm run build` in /viewer. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\viewer.html" LogicalName="CodeMap.viewer.html" Condition="Exists('Assets\viewer.html')" />
  </ItemGroup>

</Project>
