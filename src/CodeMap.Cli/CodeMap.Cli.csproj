<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>CodeMap.Cli</RootNamespace>
    <AssemblyName>codemap</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codemap</ToolCommandName>
    <ApplicationIcon>Assets\codemap.ico</ApplicationIcon>
    <Product>CodeMap</Product>
    <PackageId>CodeMap.Tool</PackageId>
    <Description>Maps C# solutions into a relationship graph (JSON, DGML, GraphML, Cypher) and an interactive 3D map.</Description>
  </PropertyGroup>

  <!-- `dotnet publish -r <rid>` (win-x64, linux-x64, osx-arm64...) produces one executable that runs without .NET installed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMap.Core\CodeMap.Core.csproj" />
    <ProjectReference Include="..\CodeMap.Server\CodeMap.Server.csproj" />
  </ItemGroup>

  <!-- Single-file 3D viewer, produced by `npm run build` in /viewer. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\viewer.html" LogicalName="CodeMap.viewer.html" Condition="Exists('Assets\viewer.html')" />
  </ItemGroup>

</Project>
