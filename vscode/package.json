{
  "name": "codemap-3d",
  "displayName": "CodeMap 3D",
  "description": "Interactive 3D map of your C# and TypeScript / JavaScript code: dependencies, architecture layers, DI lifetimes, call flows and sequence diagrams, one click away from the code.",
  "version": "0.2.3",
  "publisher": "tomeqs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomeqs/CodeMap"
  },
  "homepage": "https://github.com/tomeqs/CodeMap",
  "bugs": "https://github.com/tomeqs/CodeMap/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "csharp",
    "dotnet",
    "typescript",
    "javascript",
    "nestjs",
    "angular",
    "architecture",
    "dependency graph",
    "code map",
    "sequence diagram",
    "3d"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#04060c",
    "theme": "dark"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:codemap.map"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The analyzer only reads the code, but in untrusted workspaces CodeMap ignores analyzer paths set by the workspace.",
      "restrictedConfigurations": [
        "codemap.analyzerPath",
        "codemap.dotnetPath",
        "codemap.nodePath"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codemap.open",
        "title": "Open Code Map",
        "category": "CodeMap",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codemap.revealInMap",
        "title": "Show in Code Map",
        "category": "CodeMap"
      },
      {
        "command": "codemap.callFlow",
        "title": "Show Call Flow",
        "category": "CodeMap"
      },
      {
        "command": "codemap.refresh",
        "title": "Analyze Again",
        "category": "CodeMap",
        "icon": "$(refresh)"
      },
      {
        "command": "codemap.openInBrowser",
        "title": "Open Map in Browser",
        "category": "CodeMap",
        "icon": "$(link-external)"
      },
      {
        "command": "codemap.chooseTarget",
        "title": "Choose What to Analyze…",
        "category": "CodeMap"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codemap.open",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(sln|slnx|slnf|csproj)$/ || resourceFilename =~ /^(package|jsconfig|tsconfig(\\.[\\w-]+)?)\\.json$/",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "codemap.revealInMap",
          "when": "resourceLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "navigation@90"
        },
        {
          "command": "codemap.callFlow",
          "when": "resourceLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "navigation@91"
        }
      ],
      "editor/title": [
        {
          "command": "codemap.refresh",
          "when": "activeWebviewPanelId == codemap.map",
          "group": "navigation"
        },
        {
          "command": "codemap.openInBrowser",
          "when": "activeWebviewPanelId == codemap.map",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codemap.revealInMap",
          "when": "editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact)$/"
        },
        {
          "command": "codemap.callFlow",
          "when": "editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codemap.revealInMap",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId =~ /^(csharp|typescript|typescriptreact|javascript|javascriptreact)$/"
      }
    ],
    "configuration": {
      "title": "CodeMap",
      "properties": {
        "codemap.liveUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Analyze again and refresh the map (keeping the camera and selection) when source or project files are saved."
        },
        "codemap.includeTests": {
          "type": "boolean",
          "default": true,
          "description": "Include test projects and test files in the map."
        },
        "codemap.includeExternal": {
          "type": "boolean",
          "default": false,
          "description": "Include the framework, NuGet and npm code the analyzed code depends on."
        },
        "codemap.gitHistory": {
          "type": "boolean",
          "default": true,
          "description": "Read git history: churn, hotspots and files that change together."
        },
        "codemap.renderer": {
          "type": "string",
          "enum": ["auto", "webgpu", "webgl"],
          "enumDescriptions": [
            "WebGPU (Metal, Direct3D 12, Vulkan) where VS Code supports it, WebGL 2 otherwise.",
            "Prefer WebGPU (falls back to WebGL 2 when it is not available).",
            "Always WebGL 2."
          ],
          "default": "auto",
          "description": "Graphics API for the 3D map. Reopen the map to apply."
        },
        "codemap.analyzerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Analyzer to use instead of the one bundled with the extension: the standalone `codemap` executable from the [releases](https://github.com/tomeqs/CodeMap/releases) (works without .NET) or a `codemap.dll`."
        },
        "codemap.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine",
          "description": "The dotnet command that runs the bundled analyzer (.NET 8 or newer)."
        },
        "codemap.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Node.js (18 or newer) that analyzes TypeScript and JavaScript. Empty: the Node.js built into VS Code, so nothing needs to be installed. Set it to a `node` executable for very large code bases (VS Code's Node.js has a smaller memory limit)."
        }
      }
    }
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node test/integration/run.js",
    "package": "npm run prepare-assets && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  }
}
