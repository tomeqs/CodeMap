{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomeqs/CodeMap/docs/codemap.schema.json",
  "title": "CodeMap graph",
  "description": "Relationship graph of a code base (C#, and other languages through plugins) produced by the codemap tool. See docs/format.md.",
  "type": "object",
  "required": ["format", "version", "nodes", "edges"],
  "properties": {
    "format": { "const": "codemap" },
    "version": { "type": "string", "pattern": "^1\\." },
    "generator": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "root": { "type": "string" },
        "kind": { "enum": ["solution", "project", "directory", "file"] },
        "name": { "type": "string" },
        "languages": {
          "type": "array",
          "description": "Languages found in the source, with what their maps call each level",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "levels": {
                "type": "object",
                "properties": {
                  "project": { "$ref": "#/$defs/levelLabel" },
                  "namespace": { "$ref": "#/$defs/levelLabel" },
                  "type": { "$ref": "#/$defs/levelLabel" },
                  "member": { "$ref": "#/$defs/levelLabel" }
                }
              },
              "external": { "type": "string" }
            }
          }
        },
        "git": {
          "type": "object",
          "properties": {
            "branch": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"] },
            "commitsAnalyzed": { "type": "integer" },
            "since": { "type": ["string", "null"] }
          }
        }
      }
    },
    "stats": { "type": "object", "additionalProperties": { "type": "integer" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "analysis": {
      "type": "object",
      "properties": {
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "nodes"],
            "properties": {
              "level": { "enum": ["project", "namespace", "type"] },
              "nodes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "hotspots": { "$ref": "#/$defs/ranking" },
        "mostComplex": { "$ref": "#/$defs/ranking" },
        "mostDepended": { "$ref": "#/$defs/ranking" },
        "unusedCandidates": { "type": "array", "items": { "type": "string" } },
        "layers": {
          "type": "array",
          "description": "Architecture layers computed from the dependency graph, bottom (index 0) to top.",
          "items": {
            "type": "object",
            "required": ["level", "layers", "upward"],
            "properties": {
              "level": { "enum": ["project", "namespace"] },
              "layers": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
              "upward": {
                "type": "array",
                "description": "Dependencies on the same or a higher layer; cutting them removes every cycle.",
                "items": {
                  "type": "object",
                  "required": ["source", "target", "weight"],
                  "properties": {
                    "source": { "type": "string" },
                    "target": { "type": "string" },
                    "kind": { "const": "upward" },
                    "weight": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "changeCoupling": {
          "type": "array",
          "description": "Types modified in the same git commits.",
          "items": {
            "type": "object",
            "required": ["source", "target", "sharedCommits", "strength", "hidden"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "sharedCommits": { "type": "integer", "minimum": 1 },
              "strength": { "type": "number", "minimum": 0, "maximum": 1 },
              "hidden": { "type": "boolean", "description": "No code dependency between the two types." }
            }
          }
        },
        "di": { "$ref": "#/$defs/di" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "project", "package", "assembly", "namespace",
                "class", "interface", "struct", "record", "recordStruct", "enum", "delegate",
                "method", "constructor", "property", "field", "event",
                "module", "function", "typeAlias", "variable"
              ]
            },
            { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "description": "other languages may add kinds; give them a level" }
          ]
        },
        "level": { "$ref": "#/$defs/level" },
        "name": { "type": "string" },
        "fullName": { "type": "string" },
        "parent": { "type": "string" },
        "project": { "type": "string" },
        "language": { "type": "string", "description": "project and package nodes: id of a source.languages entry" },
        "namespace": { "type": "string" },
        "accessibility": { "enum": ["public", "internal", "protected", "private", "protected internal", "private protected"] },
        "modifiers": { "type": "array", "items": { "type": "string" } },
        "signature": { "type": "string" },
        "baseType": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "extraLocations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "attributes": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "doc": { "type": "string" },
        "external": { "type": "boolean" },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "projectReference", "packageReference", "inherits", "implements", "overrides", "calls",
                "instantiates", "accesses", "subscribes", "throws", "catches", "uses", "holds", "returns",
                "accepts", "injects", "extends", "decoratedWith", "imports", "changesWith"
              ]
            },
            { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
          ]
        },
        "weight": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1, "description": "calls / instantiates: line of the first occurrence in the source member's file" }
      }
    },
    "location": {
      "type": "object",
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "level": { "enum": ["project", "namespace", "type", "member"] },
    "levelLabel": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2, "description": "[singular, plural]" },
    "lifetime": { "enum": ["singleton", "scoped", "transient"] },
    "di": {
      "type": "object",
      "required": ["registrations", "dependencies", "issues"],
      "properties": {
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "lifetime", "kind"],
            "properties": {
              "service": { "type": "string" },
              "external": { "type": "boolean" },
              "implementation": { "type": "string" },
              "lifetime": { "$ref": "#/$defs/lifetime" },
              "kind": { "enum": ["type", "instance", "factory", "forward", "hosted", "dbcontext", "httpclient", "controller", "component"] },
              "effective": { "$ref": "#/$defs/lifetime" },
              "framework": { "type": "string" },
              "key": { "type": "string" },
              "registeredIn": { "type": "string" },
              "location": { "$ref": "#/$defs/location" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["consumer", "consumerLifetime", "service", "implementations"],
            "properties": {
              "consumer": { "type": "string" },
              "consumerLifetime": { "$ref": "#/$defs/lifetime" },
              "service": { "type": "string" },
              "external": { "type": "boolean" },
              "many": { "type": "boolean" },
              "optional": { "type": "boolean" },
              "implementations": { "type": "array", "items": { "type": "string" } },
              "lifetime": { "$ref": "#/$defs/lifetime" },
              "framework": { "type": "string" }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "severity", "consumer", "service", "message"],
            "properties": {
              "kind": { "enum": ["captive", "captive-transient", "unregistered", "interface-injection", "scope-bubbling", "unreachable"] },
              "severity": { "enum": ["error", "warning", "info"] },
              "consumer": { "type": "string" },
              "service": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score"],
        "properties": { "id": { "type": "string" }, "score": { "type": "number" } }
      }
    }
  }
}
